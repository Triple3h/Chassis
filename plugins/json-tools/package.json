{
  "name": "json-tools",
  "title": "JSON 工具箱",
  "author": "triple3h",
  "description": "无损格式化 / 压缩 / 键排序 / 错误定位 / 中文转Unicode、整篇 \\ 转义与还原；左栏是带行号 + 高亮 + 折叠的编辑器（原地改写、Tab 缩进、⌘Z 可撤销），右栏树视图可改键改值与增删成员，10MB 级 JSON 也不卡；最多 8 个子标签页并行处理多份 JSON，最近 20 份自动进历史随时回溯",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "apiVersion": "1",
  "icon": "braces",
  "categories": [
    "developer",
    "tool"
  ],
  "capabilities": [
    "hostUi",
    "storage"
  ],
  "commands": [
    {
      "name": "json",
      "title": "JSON 格式化",
      "mode": "view",
      "searchable": true,
      "placeholder": "粘贴 JSON，回车即格式化",
      "icon": "braces"
    }
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "build:view": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "node ../../scripts/run-ts.mjs test/core.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@launcher/ui": "workspace:*",
    "@launcher/api": "workspace:*",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.11"
  }
}
