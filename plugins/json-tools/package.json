{
  "name": "json-tools",
  "title": "JSON 工具箱",
  "author": "triple3h",
  "description": "无损格式化 / 压缩 / 键排序 / 错误定位 / Unicode 转义还原；树视图带类型徽标、行号定位、路径与子树复制，10MB 级 JSON 也不卡",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "apiVersion": "1",
  "icon": "braces",
  "categories": [
    "developer",
    "tool"
  ],
  "capabilities": [
    "hostUi"
  ],
  "commands": [
    {
      "name": "json",
      "title": "JSON 格式化",
      "mode": "view",
      "searchable": true,
      "placeholder": "粘贴 JSON，回车即格式化",
      "icon": "braces"
    }
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "build:view": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "node ../../scripts/run-ts.mjs test/core.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@launcher/ui": "workspace:*",
    "@launcher/api": "workspace:*",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.11"
  }
}
