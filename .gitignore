node_modules/
dist/
*.tsbuildinfo
.DS_Store
tmp-*
plugins/release/

# CodeBuddy 的本地目录：默认只放本地
# 规则（rules）与技能（skills）入库、随代码版本化；记忆（memory）等其它内容不入库
.codebuddy/*
!.codebuddy/rules/
!.codebuddy/skills/
# 代码图谱缓存
.codegraph/

# 本地运行数据（内核 dataRoot 的默认位置在 appData，这里是开发兜底）
.dev-data/
.dev/
apps/shell/target/
# M5：根级 Rust workspace 的产物（内核 / 插件 SDK / 插件逻辑层）
/target/
apps/shell/gen/
apps/shell/resources/kernel/
apps/shell/resources/ui/
apps/shell/resources/builtin-plugins/
dist-app/
