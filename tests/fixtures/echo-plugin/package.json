{
  "name": "echo-plugin",
  "title": "契约测试插件",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "apiVersion": "2",
  "description": "覆盖宿主 API 全表的契约测试插件（requirements §11 / plugin-spec §14）；逻辑层产物 = SDK 的 echo 示例二进制",
  "author": "launcher",
  "icon": "terminal",
  "keywords": ["echo", "contract", "test"],
  "capabilities": [
    "hostUi",
    "storage",
    "clipboard.read",
    "clipboard.write",
    "shell.open",
    "exec.spawn",
    "notify.show",
    "screenshot",
    "quicklink"
  ],
  "commands": [
    { "name": "echo", "title": "契约自检", "mode": "view", "searchable": true, "placeholder": "随便输入" },
    { "name": "job", "title": "契约任务（后台）", "mode": "no-view", "searchable": true },
    { "name": "compute", "title": "契约计算（脚本）", "mode": "script" },
    { "name": "feed", "title": "契约搜索源", "mode": "script", "contributes": true }
  ],
  "dependencies": {
    "@launcher/api": "workspace:*"
  }
}
